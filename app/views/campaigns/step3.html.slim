- content_for :title, "New Campaign: Step 3 – MyG2"

.fixed.inset-0 style="background: rgba(0,0,0,0.4); z-index: 40;"

.fixed.inset-0.flex.items-center.justify-center style="z-index: 50;"
  .bg-white.rounded-2xl.overflow-hidden.w-full style="max-width: 608px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px rgba(0,0,0,0.25);"

    / Modal illustration header
    .relative.overflow-hidden style="height: 180px; background: linear-gradient(135deg, #f0f0ff 0%, #e8e0ff 50%, #ddd0ff 100%);"
      button.absolute.top-4.right-4.text-gray-500.hover:text-gray-700.rounded-full.bg-white style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;"
        = link_to step2_campaigns_path(strategy: @strategy[:key], landing_page_name: @landing_page_name), class: "text-gray-600"
          svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
      .flex.items-center.justify-center.h-full.gap-2
        - 3.times do
          svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" style="color: #6b4de6; opacity: 0.7;" viewBox="0 0 20 20" fill="currentColor"
            path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"

    / Modal body
    .px-8.pt-6.pb-8
      h2.text-xl.font-bold.text-gray-900.mb-1 Create a Review Landing Page
      p.text-sm.text-gray-500.mb-5 Build a custom landing page that gets your reviewers started off on the right foot. Add compelling messaging and incentives along with other customizations.

      / Progress bar
      .mb-1
        .flex.gap-1.5
          .rounded-full.h-1.5.flex-1 style="background-color: #6b4de6;"
          .rounded-full.h-1.5.flex-1 style="background-color: #6b4de6;"
          .rounded-full.h-1.5.flex-1 style="background-color: #6b4de6;"
        p.text-xs.text-gray-500.mt-1 Step 3/3

      .mt-6
        = form_with url: create_campaign_campaigns_path, method: :post do |f|
          = f.hidden_field :strategy, value: @strategy[:key]
          = f.hidden_field :landing_page_name, value: @landing_page_name

          / UTM Parameters
          label.block.text-sm.font-medium.text-gray-700.mb-1
            | Add Your UTM Parameters
            span.text-gray-400.text-xs.ml-1 ⓘ
            span.text-red-500.ml-0.5 *

          p.text-xs.text-gray-500.mb-4 Create a list of keywords you will use to measure the success of each strategy or individual. Incoming reviews will be tagged with these values so you can accurately attribute the source of the review.

          / Pre-filled UTM entries
          p.text-sm.font-medium.text-gray-700.mb-3 2 UTM Links Successfully Created

          / Existing entries
          .space-y-2.mb-2
            .flex.items-center.gap-2
              input type="text" value="ryan" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" name="utm_params[]"
              button.px-3.py-2.text-sm.text-blue-500.border.border-gray-300.rounded-lg.flex.items-center.gap-1.hover:bg-gray-50
                | Preview
                svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              button.flex.items-center.justify-center.border.border-gray-300.rounded-lg.hover:bg-red-50 style="width: 36px; height: 36px;"
                svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"

            .flex.items-center.gap-2
              input type="text" value="david" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" name="utm_params[]"
              button.px-3.py-2.text-sm.text-blue-500.border.border-gray-300.rounded-lg.flex.items-center.gap-1.hover:bg-gray-50
                | Preview
                svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              button.flex.items-center.justify-center.border.border-gray-300.rounded-lg.hover:bg-red-50 style="width: 36px; height: 36px;"
                svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"

            / Empty input for new entry
            .flex.items-center.gap-2
              input type="text" placeholder="Enter UTM parameter/keyword..." class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" name="utm_params[]"
              button.flex.items-center.justify-center.border.border-gray-300.rounded-lg.hover:bg-red-50 style="width: 36px; height: 36px;"
                svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"

          / Add parameter button
          button type="button" class="flex items-center gap-1 text-sm font-medium mt-2 mb-6" style="color: #6b4de6;"
            svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
            | Add Parameter

          / Footer
          .flex.items-center.justify-between
            = link_to "Cancel", select_strategy_campaigns_path, class: "px-5 py-2 rounded-full border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50"
            .flex.gap-2
              = link_to "Back", step2_campaigns_path(strategy: @strategy[:key], landing_page_name: @landing_page_name), class: "px-5 py-2 rounded-full border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50"
              = f.submit "Create Page →", class: "px-6 py-2.5 rounded-full text-sm font-semibold text-white cursor-pointer", style: "background-color: #3d2b8e;"
