- content_for :title, "New Campaign: Step 1 – MyG2"

/ Page background (dimmed campaigns table behind modal)
.relative
  / Dimmed background
  .fixed.inset-0 style="background: rgba(0,0,0,0.4); z-index: 40;"

  / Modal
  .fixed.inset-0.flex.items-center.justify-center style="z-index: 50;"
    .bg-white.rounded-2xl.overflow-hidden.w-full style="max-width: 608px; box-shadow: 0 25px 50px rgba(0,0,0,0.25);"

      / Modal illustration header
      .relative.overflow-hidden style="height: 200px; background: linear-gradient(135deg, #f0f0ff 0%, #e8e0ff 50%, #ddd0ff 100%);"
        button.absolute.top-4.right-4.text-gray-500.hover:text-gray-700.rounded-full.bg-white style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;"
          = link_to select_strategy_campaigns_path, class: "text-gray-600"
            svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
        .flex.items-center.justify-center.h-full
          svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" style="color: #6b4de6; opacity: 0.5;" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"

      / Modal body
      .px-8.pt-6.pb-8
        h2.text-xl.font-bold.text-gray-900.mb-1 = @strategy[:name]
        p.text-sm.text-gray-500.mb-6 = @strategy[:description]

        / Progress bar
        .mb-1
          .flex.gap-1.5
            .rounded-full.h-1.5.flex-1 style="background-color: #6b4de6;"
            .rounded-full.h-1.5.flex-1 style="background-color: #e5e7eb;"
            .rounded-full.h-1.5.flex-1 style="background-color: #e5e7eb;"
          p.text-xs.text-gray-500.mt-1 Step 1/3

        .mt-6
          = form_with url: step2_campaigns_path, method: :get do |f|
            = f.hidden_field :strategy, value: @strategy[:key]

            .mb-4
              label.block.text-sm.font-medium.text-gray-700.mb-1
                | Landing Page Name
                span.text-gray-400.text-xs.ml-1 ⓘ
                span.text-red-500.ml-0.5 *
              = f.text_field :landing_page_name, placeholder: "Give your landing page a unique name", class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:border-transparent", style: "focus-ring-color: #6b4de6;"
              .flex.justify-between.mt-1
                span.text-xs.text-gray-400 Max 40 characters
                span.text-xs.text-gray-400 0 / 40

            / Footer
            .flex.items-center.justify-between.mt-6
              = link_to "Cancel", select_strategy_campaigns_path, class: "px-5 py-2 rounded-full border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50"
              = f.submit "Save & Continue →", class: "px-6 py-2.5 rounded-full text-sm font-semibold text-white cursor-pointer", style: "background-color: #3d2b8e;"
