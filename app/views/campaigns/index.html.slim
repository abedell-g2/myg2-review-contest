- content_for :title, "Your Campaigns – MyG2"

.px-8.py-6

  / Breadcrumb
  nav.flex.items-center.gap-1.text-sm.text-gray-500.mb-4
    a.hover:text-gray-700 href="#" Dashboard
    span.mx-1 >
    a.hover:text-gray-700 href="#" Reviews
    span.mx-1 >
    span.text-gray-800 Review Refresh

  / Page header
  .flex.items-center.justify-between.mb-6
    h1.text-2xl.font-bold.text-gray-900 Your Campaigns
    = link_to select_strategy_campaigns_path, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white", style: "background-color: #3d2b8e;" do
      | Create New Strategy
      svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"

  / Campaigns table card
  .bg-white.rounded-lg style="border: 1px solid #e5e7eb;"
    .flex.items-center.justify-between.px-6.py-4 style="border-bottom: 1px solid #e5e7eb;"
      .flex.items-center.gap-2
        h2.text-base.font-semibold.text-gray-900 Review Campaigns
        svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0"
      button.flex.items-center.gap-1.px-3.py-1.text-sm.text-gray-600.rounded.border.border-gray-300.hover:bg-gray-50
        svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
        | Filter Table
        svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"

    / Table
    .overflow-x-auto
      table.w-full.text-sm
        thead style="border-bottom: 1px solid #e5e7eb;"
          tr
            th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Campaign Title
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Incentivized
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Incentivize Amount
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Amount Spent
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Review Goal
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Campaign Type
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Landing Page
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Status
            th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider Action

        tbody
          - @campaigns.each_with_index do |c, i|
            tr class="#{i > 0 ? 'border-t border-gray-100' : ''} hover:bg-gray-50"
              td.px-6.py-4.font-medium.text-gray-900 = c[:title]
              td.px-4.py-4.text-gray-600 = c[:incentivized] ? "Yes" : "–"
              td.px-4.py-4.text-gray-600 = c[:amount]
              td.px-4.py-4.text-gray-600 = c[:spent]
              td.px-4.py-4.text-gray-600 = c[:goal]
              td.px-4.py-4.text-gray-600 = c[:type]
              td.px-4.py-4
                - if c[:landing_page]
                  a.text-blue-500.hover:underline href="#" = c[:landing_page]
                - else
                  span.text-gray-400 –
              td.px-4.py-4
                .flex.items-center.gap-1.5
                  - if c[:status] == "active"
                    span.rounded-full style="width: 8px; height: 8px; background-color: #22c55e; flex-shrink: 0;"
                    span.text-gray-700 Active
                  - else
                    span.rounded-full style="width: 8px; height: 8px; background-color: #ef4444; flex-shrink: 0;"
                    span.text-gray-700 Inactive
              td.px-4.py-4
                - if c[:action] == "Edit"
                  a.text-blue-500.hover:underline href="#" Edit
                - elsif c[:action] == "Settings"
                  a.text-blue-500.hover:underline href="#" Settings
                - else
                  a.text-blue-500.hover:underline href="#" Checkout
