doctype html
html
  head
    title = content_for(:title) || "MyG2 Review Contest"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    link rel="manifest" href="/manifest.json"
    link rel="icon" href="/icon.png" type="image/png"
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  body class="bg-gray-100 font-sans"

    .flex.h-screen.overflow-hidden

      / Dark sidebar
      nav.flex.flex-col.justify-between style="background-color: #1b2744; min-width: 240px; width: 240px;"
        div
          / Logo area
          .flex.items-center.justify-between.px-4.py-4 style="border-bottom: 1px solid rgba(255,255,255,0.1);"
            a href="/" class="flex items-center gap-2"
              span.font-bold.text-white.text-2xl my.
              span class="text-white font-black text-2xl" style="color: #ff4a00;" G2
            button.text-gray-400.p-1
              svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"

          / Product dropdown
          .px-3.py-2
            button.flex.items-center.gap-2.w-full.px-2.py-2.rounded.text-white.text-sm style="background: rgba(255,255,255,0.1);"
              .flex.items-center.justify-center.rounded style="background: #6b7280; width: 28px; height: 28px;"
                span.text-white.text-xs.font-bold AI
              span.flex-1.text-left Acme Inc.
              svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"

          / Navigation
          .px-2.py-2
            = render "layouts/nav_item", icon: "profile", label: "Product Profile", active: false
            = render "layouts/nav_item", icon: "activity", label: "Buyer Activity", active: false

          .px-3.pt-3.pb-1
            span.text-xs.font-semibold.uppercase.tracking-wider style="color: rgba(255,255,255,0.4);" Reviews

          .px-2
            = render "layouts/nav_item", icon: "star", label: "Review Activity", active: false
            = render "layouts/nav_item", icon: "chart", label: "Review Campaign Dashboard", active: false

          .px-3.pt-3.pb-1
            span.text-xs.font-semibold.uppercase.tracking-wider style="color: rgba(255,255,255,0.4);" Get Reviews

          .px-2
            = render "layouts/nav_item", icon: "mobile", label: "In-App Reviews", active: false
            = render "layouts/nav_item", icon: "generate", label: "Generate Reviews from your Site", active: false
            = render "layouts/nav_item", icon: "request", label: "Request Review Campaigns", active: true

          .px-3.pt-3.pb-1
            span.text-xs.font-semibold.uppercase.tracking-wider style="color: rgba(255,255,255,0.4);" Review Tools

          .px-2
            = render "layouts/nav_item", icon: "respond", label: "Respond to Reviewers", active: false
            = render "layouts/nav_item", icon: "references", label: "Create References", active: false
            = render "layouts/nav_item", icon: "questions", label: "Add Custom Questions", active: false

          .mt-4.px-2
            = render "layouts/nav_item", icon: "marketing", label: "Marketing Content", active: false
            = render "layouts/nav_item", icon: "analytics", label: "Analytics", active: false
            = render "layouts/nav_item", icon: "integrations", label: "Integrations", active: false
            = render "layouts/nav_item", icon: "account", label: "Account", active: false

        / Bottom link
        .px-4.py-4 style="border-top: 1px solid rgba(255,255,255,0.1);"
          a.flex.items-center.gap-2.text-sm href="#" style="color: rgba(255,255,255,0.6);"
            svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            | View product on G2.com

      / Main content
      .flex.flex-col.flex-1.overflow-hidden
        / Top header
        header.flex.items-center.justify-between.px-6.py-3.bg-white style="border-bottom: 1px solid #e5e7eb; height: 60px;"
          .flex.items-center.gap-2
            / Product dropdown
            button.flex.items-center.gap-2.text-sm.font-medium.text-gray-800.pr-4 style="border-right: 1px solid #e5e7eb;"
              .flex.items-center.justify-center.rounded style="background: #6b7280; width: 28px; height: 28px;"
                span.text-white.text-xs.font-bold AI
              span Data Studio
              svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"

          .flex.items-center.gap-4
            / Search
            .relative
              input.pl-9.pr-4.py-1.text-sm.rounded.border.border-gray-300 type="text" placeholder="Quick nav..."
              svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 absolute left-2.5 top-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"
            / Help
            button.text-gray-500.p-1.rounded-full.border.border-gray-300 style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;"
              span.text-xs.font-bold ?
            / Avatar
            .rounded-full.overflow-hidden style="width: 32px; height: 32px; background: linear-gradient(135deg, #6b4de6 0%, #a855f7 100%);"

        / Page content
        main.flex-1.overflow-y-auto.bg-gray-50
          = yield
